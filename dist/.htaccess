Options -MultiViews -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Enforce HTTPS redirection for all traffic
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Canonicalize www to apex domain on main public site
  RewriteCond %{HTTP_HOST} ^www\.ecasiafrica\.org$ [NC]
  RewriteRule ^(.*)$ https://ecasiafrica.org/$1 [L,R=301]

  # Block direct web access to any hidden files or internal data directories
  RewriteRule (^|/)\. - [F,L]

  # Permanent HTTP 301 Redirects for legacy / retired WordPress & indexed URLs
  RewriteCond %{HTTP_HOST} !^msimamizi\. [NC]
  RewriteRule ^past-training(/.*)?$ https://ecasiafrica.org/gallery [R=301,L,NC]

  RewriteCond %{HTTP_HOST} !^msimamizi\. [NC]
  RewriteRule ^courses/?$ https://ecasiafrica.org/institute-overview [R=301,L,NC]

  RewriteCond %{HTTP_HOST} !^msimamizi\. [NC]
  RewriteRule ^executive-training/?$ https://ecasiafrica.org/institute-overview [R=301,L,NC]

  RewriteCond %{HTTP_HOST} !^msimamizi\. [NC]
  RewriteRule ^the-institute/?$ https://ecasiafrica.org/about [R=301,L,NC]

  RewriteCond %{HTTP_HOST} !^msimamizi\. [NC]
  RewriteRule ^research/?$ https://ecasiafrica.org/research/overview [R=301,L,NC]

  RewriteCond %{HTTP_HOST} !^msimamizi\. [NC]
  RewriteRule ^consultancy/?$ https://ecasiafrica.org/research/consulting [R=301,L,NC]

  RewriteRule ^index\.html$ - [L]

  # Prevent 404s from legacy physical folders/files for key SPA routes
  RewriteRule ^contact/?$ /index.html [L]
  RewriteRule ^gallery/?$ /index.html [L]
  RewriteRule ^programmes/?$ /index.html [L]
  RewriteRule ^msimamizi/?$ /index.html [L]
  RewriteRule ^admin/?$ /index.html [L]
  RewriteRule ^portal/?$ /index.html [L]

  # Route API endpoints cleanly
  RewriteRule ^api/verify-turnstile/?$ /api/verify-turnstile.php [L]
  RewriteRule ^api/verify-recaptcha/?$ /api/verify-recaptcha.php [L]
  RewriteRule ^api/msimamizi-sync/?$ /api/msimamizi-sync.php [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# Block direct access to sensitive config, backup, environment, and internal library files
<FilesMatch "(^\.env|\.bak$|\.sql$|\.log$|\.ini$|\.json$|composer\.(json|lock)|package(-lock)?\.json|security-lib\.php|db\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Mark Admin Portal Subdomain & Routes for Strict Non-Indexing
<IfModule mod_setenvif.c>
  SetEnvIfNoCase Host ^msimamizi\. IS_MSIMAMIZI_PORTAL=1
  SetEnvIfNoCase Request_URI ^/(msimamizi|admin|portal|api)(/|$) IS_MSIMAMIZI_PORTAL=1
</IfModule>

# Configure Secure Server HTTP Headers
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://www.googletagmanager.com https://www.google-analytics.com https://www.clarity.ms https://scripts.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; frame-src 'self' https://challenges.cloudflare.com https://www.youtube.com https://www.youtube-nocookie.com https://www.google.com; child-src 'self' blob: https://challenges.cloudflare.com; worker-src 'self' blob: https://challenges.cloudflare.com; connect-src 'self' https://ecasiafrica.org https://msimamizi.ecasiafrica.org https://msimamiziecasi.vercel.app https://challenges.cloudflare.com https://www.google-analytics.com https://region1.google-analytics.com https://www.clarity.ms https://*.clarity.ms; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://ecasiafrica.org https://msimamizi.ecasiafrica.org; upgrade-insecure-requests;"
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex" env=IS_MSIMAMIZI_PORTAL
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex" env=REDIRECT_IS_MSIMAMIZI_PORTAL
  Header unset X-Powered-By
  Header unset Server
</IfModule>
