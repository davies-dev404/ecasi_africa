Options -MultiViews -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Enforce HTTPS redirection for all traffic
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Block direct web access to any hidden files or internal data directories
  RewriteRule (^|/)\. - [F,L]

  RewriteRule ^index\.html$ - [L]

  # Prevent 404s from legacy physical folders/files for key SPA routes
  RewriteRule ^contact/?$ /index.html [L]
  RewriteRule ^gallery/?$ /index.html [L]
  RewriteRule ^programmes/?$ /index.html [L]
  RewriteRule ^msimamizi/?$ /index.html [L]
  RewriteRule ^admin/?$ /index.html [L]
  RewriteRule ^portal/?$ /index.html [L]

  # Route API endpoints cleanly
  RewriteRule ^api/verify-turnstile/?$ /api/verify-turnstile.php [L]
  RewriteRule ^api/verify-recaptcha/?$ /api/verify-recaptcha.php [L]
  RewriteRule ^api/msimamizi-sync/?$ /api/msimamizi-sync.php [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# Configure Secure Server HTTP Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "DENY"
  Header set X-XSS-Protection "1; mode=block"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Content-Security-Policy "upgrade-insecure-requests;"
</IfModule>
